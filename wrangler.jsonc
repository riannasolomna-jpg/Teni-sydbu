{
  "$schema": "https://developers.cloudflare.com/workers/wrangler/config-schema.json",
  "name": "arhiv-doma",
  "main": "worker.js",
  "compatibility_date": "2026-09-04",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/media/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "arhiv-doma",
      "database_id": "752d2a01-77fa-4bd9-9ebe-393b9cfbb1b4"
    }
  ]
}
