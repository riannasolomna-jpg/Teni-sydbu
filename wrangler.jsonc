{
  "$schema": "https://developers.cloudflare.com/workers/wrangler/config-schema.json",
  "name": "arhiv-doma",
  "main": "worker.js",
  "compatibility_date": "2026-09-04",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/media/*"]
  }
}

{
  "$schema": "https://developers.cloudflare.com/workers/wrangler/config-schema.json",
  "name": "arhiv-doma",
  "main": "worker.js",
  "compatibility_date": "2026-09-04",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/media/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "arhiv-doma",
      "database_id": "СЮДА_ВСТАВЬ_ID_ИЗ_CLOUDFLARE"
    }
  ]
}
